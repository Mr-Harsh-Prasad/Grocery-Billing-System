<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Application.controllers.ProductController">
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
         <children>
            <Label text="Products">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label text="Manage Your Project Inventory" />
            <HBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER_LEFT" maxHeight="700.0" maxWidth="300.0" styleClass="SectionBox" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Product Information" textAlignment="CENTER">
                           <VBox.margin>
                              <Insets bottom="20.0" left="10.0" right="5.0" top="5.0" />
                           </VBox.margin></Label>
                        <Label text="Product Name">
                           <VBox.margin>
                              <Insets left="10.0" right="5.0" />
                           </VBox.margin></Label>
                        <TextField fx:id="productNameField" promptText="Enter Product Name">
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" />
                           </VBox.margin></TextField>
                        <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
                           <children>
                              <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Category" VBox.vgrow="ALWAYS" />
                                    <ChoiceBox fx:id="categoryChoiceBox" prefWidth="150.0" VBox.vgrow="ALWAYS" />
                                    <Label text="Purchase Price" VBox.vgrow="ALWAYS" />
                                    <TextField fx:id="purchasePriceField" VBox.vgrow="ALWAYS" />
                                    <Label text="Stock Quantity" VBox.vgrow="ALWAYS" />
                                    <TextField fx:id="stockQuantityField" VBox.vgrow="ALWAYS" />
                                 </children>
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin>
                              </VBox>
                              <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Unit" VBox.vgrow="ALWAYS" />
                                    <TextField fx:id="unitField" VBox.vgrow="ALWAYS" />
                                    <Label text="Selling Price" VBox.vgrow="ALWAYS" />
                                    <TextField fx:id="sellingPriceField" VBox.vgrow="ALWAYS" />
                                    <Label text="Reorder Level" VBox.vgrow="ALWAYS" />
                                    <TextField fx:id="reorderLevelField" VBox.vgrow="ALWAYS" />
                                 </children>
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin>
                              </VBox>
                           </children>
                        </HBox>
                        <Label text="Description (Optional)" VBox.vgrow="ALWAYS">
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </VBox.margin></Label>
                        <TextArea fx:id="descriptionArea" maxHeight="200.0" maxWidth="300.0" prefHeight="50.0" prefWidth="300.0" promptText="Enter Product Description" VBox.vgrow="ALWAYS">
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </VBox.margin></TextArea>
                        <HBox alignment="CENTER">
                           <children>
                              <Button fx:id="clearButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleClear" text="Clear" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                              <Button fx:id="addProductButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAddProduct" text="+ Add Product" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                              <Button fx:id="handleUpdateProduct" alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Update" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                              <Button fx:id="deleteProductButton" alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDeleteProduct" text="Delete" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </VBox.margin>
                        </HBox>
                     </children>
                     <HBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </HBox.margin>
                  </VBox>
                  <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="SectionBox" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="SectionBox" VBox.vgrow="ALWAYS">
                           <children>
                              <Label text="Product List" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Label>
                              <Region HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin>
                              </Region>
                              <TextField>
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></TextField>
                              <Button mnemonicParsing="false" text="Filter" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                              <Region HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin>
                              </Region>
                              <Button mnemonicParsing="false" text="Refresh" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                           </children>
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </VBox.margin>
                        </HBox>
                        <TableView fx:id="productTable" maxHeight="550.0" maxWidth="1.7976931348623157E308" VBox.vgrow="NEVER">
                          <columns>
                            <TableColumn fx:id="idColumn" prefWidth="75.0" text="#" />
                            <TableColumn fx:id="productNameColumn" prefWidth="75.0" text="Product Name" />
                            <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Category" />
                            <TableColumn fx:id="unitColumn" prefWidth="75.0" text="Unit" />
                            <TableColumn fx:id="purchasePriceColumn" prefWidth="75.0" text="Purchase Price" />
                            <TableColumn fx:id="sellingPriceColumn" prefWidth="75.0" text="Selling Price" />
                            <TableColumn fx:id="stockQuantityColumn" prefWidth="75.0" text="Stock" />
                            <TableColumn fx:id="actionsColumn" prefWidth="75.0" text="Actions" />
                          </columns>
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </VBox.margin>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
                           <children>
                              <Button mnemonicParsing="false" text="|&lt;" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                              <Button mnemonicParsing="false" text="&lt;" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                              <Button mnemonicParsing="false" text="no." HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                              <Button mnemonicParsing="false" text="&gt;" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                              <Button mnemonicParsing="false" text="&gt;|" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin></Button>
                           </children>
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </VBox.margin>
                        </HBox>
                     </children>
                     <HBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </HBox.margin>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
