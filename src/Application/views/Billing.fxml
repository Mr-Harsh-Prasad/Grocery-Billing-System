                        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                     </VBox.margin></Label>
                  <Label text="Dairy">
                     <VBox.margin>
                        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                     </VBox.margin></Label>
                  <Label text="Personal Care">
                     <VBox.margin>
                        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                     </VBox.margin></Label>
                  <Label text="Household">
                     <VBox.margin>
                        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                     </VBox.margin></Label>
                  <Label text="Baby Care">
