                  <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
               </HBox.margin></Label>
            <Label alignment="CENTER" text="Label">
               <HBox.margin>
                  <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
               </HBox.margin></Label>
         </children>
      </HBox>
   </top>
