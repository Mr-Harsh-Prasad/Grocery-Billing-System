<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="Application.controllers.CustomerController"
        stylesheets="@../style/style.css"
        maxWidth="1.7976931348623157E308"
        maxHeight="1.7976931348623157E308">

   <!-- ================= TOP ================= -->

   <top>

      <HBox
              alignment="CENTER"
              spacing="12"
              styleClass="section">

         <padding>
            <Insets top="10" bottom="10" left="10" right="10"/>
         </padding>

         <!-- Logo -->

         <ImageView
                 fitHeight="50"
                 fitWidth="50"
                 preserveRatio="true"
                 pickOnBounds="true">

            <image>
               <Image url="@../images/customer_logo.png"/>
            </image>

         </ImageView>

         <!-- Title -->

         <VBox
                 alignment="CENTER_LEFT"
                 spacing="2">

            <Label
                    text="Customers"
                    styleClass="label-text"/>

            <Label
                    text="Add, update and manage customer details"/>

         </VBox>

         <Region HBox.hgrow="ALWAYS"/>

         <!-- Search -->

         <TextField
                 fx:id="searchField"
                 prefWidth="300"
                 promptText="Search customer by name or phone"/>

         <Button
                 text="Search"/>

         <Button
                 text="Refresh"
                 onAction="#handleRefresh"/>

      </HBox>

   </top>


   <!-- ================= CENTER ================= -->

   <center>

      <HBox
              spacing="10">

         <padding>
            <Insets top="5" bottom="5" left="5" right="5"/>
         </padding>


         <!-- ================= CUSTOMER TABLE ================= -->

         <VBox
                 spacing="8"
                 styleClass="section"
                 HBox.hgrow="ALWAYS">

            <Label
                    text="Customer List"
                    styleClass="label-text"/>

            <TableView
                    fx:id="customerTable"
                    VBox.vgrow="ALWAYS">

               <columns>

                  <TableColumn
                          fx:id="idColumn"
                          text="ID"
                          prefWidth="70"/>

                  <TableColumn
                          fx:id="nameColumn"
                          text="Name"
                          prefWidth="220"/>

                  <TableColumn
                          fx:id="phoneColumn"
                          text="Phone"
                          prefWidth="180"/>

               </columns>

            </TableView>

         </VBox>


         <!-- ================= DETAILS ================= -->

         <VBox
                 prefWidth="320"
                 spacing="15"
                 styleClass="section">

            <HBox
                    alignment="CENTER">

               <Label
                       text="Customer Details"
                       styleClass="label-text"/>

               <Region HBox.hgrow="ALWAYS"/>

               <Button
                       text="Clear"
                       onAction="#handleClear"/>

            </HBox>


            <!-- Details -->

            <HBox spacing="10">

               <VBox
                       spacing="15"
                       prefWidth="120">

                  <Label text="Customer ID"/>
                  <Label text="Name"/>
                  <Label text="Phone"/>
                  <Label text="Total Purchase"/>
                  <Label text="Total Orders"/>

               </VBox>


               <VBox
                       spacing="15"
                       prefWidth="160">

                  <Label
                          fx:id="customerIdLabel"
                          text="-"/>

                  <Label
                          fx:id="customerNameLabel"
                          text="-"/>

                  <Label
                          fx:id="customerPhoneLabel"
                          text="-"/>

                  <Label
                          fx:id="totalPurchaseLabel"
                          text="₹ 0.00"/>

                  <Label
                          fx:id="totalOrdersLabel"
                          text="0"/>

               </VBox>

            </HBox>


            <Region VBox.vgrow="ALWAYS"/>


            <!-- Customer actions -->

            <HBox
                    spacing="8"
                    alignment="CENTER">

               <Button
                       text="+ Add Customer"
                       onAction="#handleAddCustomer"/>

               <Button
                       text="Update"
                       onAction="#handleUpdateCustomer"/>

               <Button
                       text="Delete"
                       onAction="#handleDeleteCustomer"/>

            </HBox>

         </VBox>

      </HBox>

   </center>


   <!-- ================= BOTTOM ================= -->

   <bottom>

      <HBox
              alignment="CENTER"
              spacing="10"
              styleClass="section">

         <padding>
            <Insets top="10" bottom="10" left="10" right="10"/>
         </padding>

         <Button
                 text="Clear Selection"
                 onAction="#handleClear"/>

         <Region HBox.hgrow="ALWAYS"/>

         <Label
                 text="Select a customer from the table to manage their details."/>

      </HBox>

   </bottom>

</BorderPane>